% =========================================================================
%  preamble.sty -- Sorin's maths macros
%
%  Ported from HMC/preamble.sty (the one Obsidian's "obsidian-latex" plugin
%  feeds to MathJax), plus the commands your notes actually use that MathJax
%  provides for free but real LaTeX does not (\ket, \bra, \braket, ...).
%
%  Two collisions had to be resolved, because MathJax has no built-ins to
%  clash with but LaTeX does:
%      \div   LaTeX already has it (the division sign)      -> \renewcommand
%      \abs   siunitx/physics-style packages also define it -> \providecommand
% =========================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{preamble}[2026/09/12 Sorin's maths macros]

\RequirePackage{amsmath,amssymb,mathtools}

% ---- Dirac notation -----------------------------------------------------
% Your notes write \braket{ +z | +n } -- ONE argument with a bar inside, the
% way MathJax's braket extension accepts it (187 of 191 uses in the vault).
% braket.sty handles that but, under unicode-math, sets the bar so that the
% following "+" is read as a binary operator: you get "<+z| + z>" with a gap.
%
% This splits on | instead, joins the pieces with a properly sized \middle\vert
% and symmetric thin spaces, and closes with \mathopen{} so a leading +/- in
% the next piece stays unary. It also handles three pieces for free, so matrix
% elements \braket{ psi | A | phi } come out right.
\ExplSyntaxOn
\seq_new:N \l__hmc_braket_seq
\cs_new_protected:Npn \__hmc_braket:n #1
  {
    \seq_set_split:Nnn \l__hmc_braket_seq { | } {#1}
    \left \langle
      \seq_use:Nn \l__hmc_braket_seq { \, \middle \vert \, \mathopen{} }
    \right \rangle
  }
\NewDocumentCommand \braket { m } { \__hmc_braket:n {#1} }
\ExplSyntaxOff

\DeclarePairedDelimiterX{\bra}[1]{\langle}{\rvert}{#1}
\DeclarePairedDelimiterX{\ket}[1]{\lvert}{\rangle}{#1}
\DeclarePairedDelimiterX{\ketbra}[2]{\lvert}{\rvert}%
  {#1\delimsize\rangle\delimsize\langle #2}

% ---- from your Obsidian preamble.sty -----------------------------------
\newcommand{\bb}[1]{\mathbb{#1}}
\newcommand{\bvec}[1]{\mathbf{#1}}
\newcommand{\pardx}[2]{\frac{\partial #1}{\partial #2}}
\newcommand{\ddx}[2]{\frac{d #1}{d #2}}

\providecommand{\norm}[1]{\left\Vert #1 \right\Vert}
\providecommand{\abs}[1]{\left\vert #1 \right\vert}

\newcommand{\curl}{\operatorname{curl}}
\renewcommand{\div}{\operatorname{div}}   % \div is taken in LaTeX
\newcommand{\grad}{\operatorname{grad}}
\DeclareMathOperator{\vspan}{span}

% ---- things MathJax gave you for free -----------------------------------
% braket.sty supplies \bra, \ket, \braket, \set. These fill the rest of the
% gaps your notes rely on.
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\sgn}{sgn}
\DeclareMathOperator{\Res}{Res}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

\providecommand{\ketbra}[2]{\left|#1\middle\rangle\middle\langle#2\right|}
\providecommand{\expval}[1]{\left\langle #1 \right\rangle}
\providecommand{\dd}{\mathop{}\!d}

% ---- \sqrt[]{x} with an EMPTY index ------------------------------------
% Your `sq` snippet produces \sqrt[]{ }. MathJax shrugs off the empty index;
% unicode-math feeds it to \ifnum and dies with "Improper alphabetic
% constant". Treat [] as "no index". Done at \begin{document} because
% unicode-math only installs its own \sqrt when the maths font is set up.
\AtBeginDocument{%
  \NewCommandCopy\hmc@origsqrt\sqrt
  \RenewDocumentCommand\sqrt{o m}{%
    \IfValueTF{#1}%
      {\if\relax\detokenize{#1}\relax
         \hmc@origsqrt{#2}%
       \else
         \hmc@origsqrt[#1]{#2}%
       \fi}%
      {\hmc@origsqrt{#2}}%
  }%
}

% Common shorthands
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Q}{\mathbb{Q}}

\newcommand{\eps}{\varepsilon}
\newcommand{\half}{\tfrac{1}{2}}

% Paired delimiters that size themselves
\DeclarePairedDelimiter{\ceil}{\lceil}{\rceil}
\DeclarePairedDelimiter{\floor}{\lfloor}{\rfloor}

\endinput
