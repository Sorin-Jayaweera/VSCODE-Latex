# ---- hand-ported (build/manual_snippets.hsnips) --------------------

# ==========================================================================
#  manual_snippets.hsnips
#
#  Snippets that can't be converted mechanically from Latex Suite. This file is
#  appended to BOTH generated snippet files, after their `global` block, so the
#  helpers math(), code() and lit() are available here.
#
#  Rules HyperSnips imposes (see build/port_snippets.py for the details):
#    * trigger is bare, or a regex in `backticks`
#    * body text is VS Code snippet syntax: write \\ for a backslash
#    * text built in JavaScript goes through lit() before it's returned
# ==========================================================================

# iden3 -> 3x3 identity matrix. Ported from the JS function snippet in
# Latex Suite.
context math(context)
snippet `iden(\d)` "N x N identity matrix" A
``
let n = parseInt(m[1]);
let rows = [];
for (let j = 0; j < n; j++) {
    let row = [];
    for (let i = 0; i < n; i++) row.push(i === j ? 1 : 0);
    rows.push(row.join(" & "));
}
rv = lit("\\begin{pmatrix}\n" + rows.join(" \\\\\n") + "\n\\end{pmatrix}");
``
endsnippet

# zeros3 -> 3x3 zero matrix
context math(context)
snippet `zeros(\d)` "N x N zero matrix" A
``
let n = parseInt(m[1]);
let row = Array(n).fill(0).join(" & ");
rv = lit("\\begin{pmatrix}\n" + Array(n).fill(row).join(" \\\\\n") + "\n\\end{pmatrix}");
``
endsnippet
