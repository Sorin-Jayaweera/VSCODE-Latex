endsnippet

context math(context)
snippet "lr[" "lr[" A
\bigg[ $0 \bigg] $1
endsnippet

context math(context)
snippet "lra" "lra" A
\left< $0 \right> $1
endsnippet

context math(context)
snippet "lr<" "lr<" A
\left< $0 \right> \ $1
endsnippet


# ---- Misc --------------------------------------------------------

context math(context)
snippet "gen" "gen" A
e^{-\frac{i}{\hbar} $0} $1
endsnippet

context math(context)
snippet "tayl" "tayl" A
${0:f}(${1:x} + ${2:h}) = ${0:f}(${1:x}) + ${0:f}'(${1:x})${2:h} + ${0:f}''(${1:x}) \frac{${2:h}^{2}}{2!} + \dots$3
endsnippet


# ---- hand-ported snippets (build/manual_snippets.hsnips) ----

# ==========================================================================
#  manual_snippets.hsnips
#
#  Snippets that can't be converted mechanically from Latex Suite, hand-ported
#  here. port_snippets.py appends this file verbatim to BOTH latex.hsnips and
#  markdown.hsnips, so add anything custom here rather than editing those
#  (they get overwritten on every re-run).
# ==========================================================================

# iden3 -> 3x3 identity matrix. Ported from the JS function snippet in
# Latex Suite. HyperSnips runs the same JavaScript between double backticks.
context math(context)
snippet `iden(\d)` "N x N identity matrix" A
``
let n = parseInt(m[1]);
let arr = [];
for (let j = 0; j < n; j++) {
    arr[j] = [];
    for (let i = 0; i < n; i++) {
        arr[j][i] = (i === j) ? 1 : 0;
    }
}
rv = "\\begin{pmatrix}\n" + arr.map(el => el.join(" & ")).join(" \\\\\n") + "\n\\end{pmatrix}";
``
endsnippet

# zeros3 -> 3x3 zero matrix (same machinery, a freebie while we're here)
context math(context)
snippet `zeros(\d)` "N x N zero matrix" A
``
let n = parseInt(m[1]);
let row = Array(n).fill(0).join(" & ");
rv = "\\begin{pmatrix}\n" + Array(n).fill(row).join(" \\\\\n") + "\n\\end{pmatrix}";
``
endsnippet
