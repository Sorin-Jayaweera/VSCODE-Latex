# ---- build scratch --------------------------------------------------------
# Generated .tex, .aux, .log from build/build.py. PDFs are NOT here: they go
# to <note folder>/pdfs/ and are tracked like the rest of the notes.
.build/
out/

# SyncTeX files sit next to PDFs in pdfs/ but are machine-specific
*.synctex.gz

# LaTeX droppings, wherever they land
*.aux
*.log
*.fls
*.fdb_latexmk
*.toc
*.out
*.nav
*.snm
*.vrb
*.bbl
*.blg
*.idx
*.ind
*.ilg

# Packaged VS Code extension (rebuild with tools/obsidian-preview/pack_vsix.py)
*.vsix

# ---- OS / editor ----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- python ---------------------------------------------------------------
__pycache__/
*.pyc
