{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build note -> PDF (dark)",
      "type": "shell",
      "command": "python",
      "args": ["build/build.py", "${file}", "--dark"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Build note -> PDF (light, for printing)",
      "type": "shell",
      "command": "python",
      "args": ["build/build.py", "${file}", "--light"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Build every note in this folder",
      "type": "shell",
      "command": "python",
      "args": ["build/build.py", "--all", "${fileDirname}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Convert note -> .tex (into .build/converted, don't compile)",
      "type": "shell",
      "command": "python",
      "args": [
        "build/md2tex.py", "${file}",
        "--vault-root", "notes",
        "-o", "${workspaceFolder}/.build/converted/${fileBasenameNoExtension}.tex"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Re-sync snippets from Obsidian",
      "type": "shell",
      "command": "python",
      "args": ["build/port_snippets.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Re-import notes from the Obsidian vault",
      "type": "shell",
      "command": "python",
      "args": ["build/import_vault.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Sync to GitHub now",
      "type": "shell",
      "command": "python",
      "args": ["build/sync.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Check all notes convert cleanly",
      "type": "shell",
      "command": "python",
      "args": ["build/smoke_test.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
