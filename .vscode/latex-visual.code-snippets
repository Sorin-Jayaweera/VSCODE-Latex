{
  "Surround: underbrace": {
    "scope": "latex,markdown",
    "prefix": "surround-underbrace",
    "body": [
      "\\\\underbrace{ $TM_SELECTED_TEXT \\}_{ $1 \\}"
    ],
    "description": "Wrap selection: underbrace (Latex Suite 'U')"
  },
  "Surround: underset": {
    "scope": "latex,markdown",
    "prefix": "surround-underset",
    "body": [
      "\\\\underset{ $1 \\}{ $TM_SELECTED_TEXT \\}"
    ],
    "description": "Wrap selection: underset (Latex Suite 'B')"
  },
  "Surround: cancel": {
    "scope": "latex,markdown",
    "prefix": "surround-cancel",
    "body": [
      "\\\\cancel{ $TM_SELECTED_TEXT \\}"
    ],
    "description": "Wrap selection: cancel (Latex Suite 'C')"
  },
  "Surround: cancelto": {
    "scope": "latex,markdown",
    "prefix": "surround-cancelto",
    "body": [
      "\\\\cancelto{ $1 \\}{ $TM_SELECTED_TEXT \\}"
    ],
    "description": "Wrap selection: cancelto (Latex Suite 'K')"
  },
  "Surround: sqrt": {
    "scope": "latex,markdown",
    "prefix": "surround-sqrt",
    "body": [
      "\\\\sqrt{ $TM_SELECTED_TEXT \\}"
    ],
    "description": "Wrap selection: sqrt (Latex Suite 'S')"
  },
  "Surround: parens": {
    "scope": "latex,markdown",
    "prefix": "surround-parens",
    "body": [
      "($TM_SELECTED_TEXT)"
    ],
    "description": "Wrap selection: parens (Latex Suite '(')"
  },
  "Surround: brackets": {
    "scope": "latex,markdown",
    "prefix": "surround-brackets",
    "body": [
      "[$TM_SELECTED_TEXT]"
    ],
    "description": "Wrap selection: brackets (Latex Suite '[')"
  },
  "Surround: braces": {
    "scope": "latex,markdown",
    "prefix": "surround-braces",
    "body": [
      "{$TM_SELECTED_TEXT\\}"
    ],
    "description": "Wrap selection: braces (Latex Suite '{')"
  }
}